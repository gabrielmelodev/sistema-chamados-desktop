{
  "name": "sistema-chamados-desktop",
  "productName": "Sistema de Chamados",
  "version": "1.0.2",
  "description": "Aplicativo desktop oficial destinado à gestão, tramitação, controle e acompanhamento das solicitações de atendimento, no âmbito do Sistema de Chamados da Prefeitura Municipal de Formosa/GO.",
  "main": "src/main/main.js",
  "author": "Prefeitura Municipal de Formosa",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "clean:win": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"Get-Process electron,app-builder -ErrorAction SilentlyContinue | Stop-Process -Force -ErrorAction SilentlyContinue; if (Test-Path './release') { Remove-Item './release' -Recurse -Force -ErrorAction SilentlyContinue }\"",
    "build:win": "npm run clean:win && electron-builder --win --x64",
    "dist": "npm run  && electron-builder"
  },
  "dependencies": {
    "electron-log": "^5.2.0",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^39.8.10",
    "electron-builder": "^25.1.8",
    "electron-reload": "2.0.0-alpha.1",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.3"
  },
  "build": {
    "appId": "br.go.formosa.sistemachamados",
    "productName": "Sistema de Chamados",
    "copyright": "Copyright © 2026 Prefeitura Municipal de Formosa",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.svg",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "SistemaDeChamados-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Sistema de Chamados",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "differentialPackage": true,
      "include": "build/installer.nsh"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "gabrielgomesdev",
        "repo": "sistema-chamados-desktop",
        "releaseType": "release"
      }
    ],
    "extraMetadata": {
      "main": "src/main/main.js"
    }
  }
}
